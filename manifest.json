{
  "manifest_version": 3,

  "name": "Twitter scroller",
  "description": "Scroll the X feed to your newest bookmark and collapse noisy tweets",
  "version": "0.3.3",
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "run_at": "document_end",
      "js": ["config.js", "script.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://openrouter.ai/*"],
  "commands": {
    "scroll": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Scroll the feed to the newest bookmarked tweet"
    }
  }
}
